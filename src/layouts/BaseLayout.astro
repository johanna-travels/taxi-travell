---
import MobileFooter from '../components/MobileFooter.astro';
import ContactOverFooter from '../components/ContactOverFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import openSansLatin from '@fontsource/open-sans/files/open-sans-latin-400-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	activeFooterId?: string;
}

const {
	title = 'Tejaku Lataxi',
	description = 'Tejaku Lataxi — Bali personal transport and taxi.',
	activeFooterId = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link
			rel="preload"
			href={openSansLatin}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<style is:inline>
			.scroll-footer {
				position: fixed;
				inset-inline: 0;
				bottom: 0;
				z-index: 50;
				background: #fff;
				border-top: 1px solid #f5f5f5;
				padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
			}
			.scroll-footer__grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				max-width: 1280px;
				margin-inline: auto;
				padding-inline: 0.5rem;
			}
			.scroll-footer__link {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0;
				padding: 0.5rem 0.25rem;
				text-align: center;
				text-decoration: none;
				color: #212529;
				min-height: 4.25rem;
			}
			.footer-icon-ring {
				display: flex;
				width: 2.5rem;
				height: 2.5rem;
				align-items: center;
				justify-content: center;
				border-radius: 9999px;
				border: 2px solid #fdb317;
				background: #f7f7f7;
				box-shadow: 0 0 0 1px rgba(253, 179, 23, 0.22);
				flex-shrink: 0;
			}
			.footer-icon-ring svg {
				width: 25px;
				height: 25px;
				color: #212529;
				fill: currentColor;
			}
			.footer-nav-label {
				margin-top: 0.375rem;
				font-size: 11.2px;
				line-height: 22px;
				max-width: 100%;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
		</style>
	</head>
	<body class="site-body font-sans text-fg-ink lg:pb-0">
		<slot />

		<ContactOverFooter />
		<SiteFooter />

		<MobileFooter activeId={activeFooterId} />

		<script>
			import { scheduleScrollSiteInit } from '../scripts/scrollSite';

			scheduleScrollSiteInit();
		</script>
	</body>
</html>
