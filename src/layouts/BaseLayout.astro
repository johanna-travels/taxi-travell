---
import MobileFooter from '../components/MobileFooter.astro';
import ContactOverFooter from '../components/ContactOverFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import openSansLatin from '@fontsource/open-sans/files/open-sans-latin-400-normal.woff2?url';

import { siteName, siteDescription } from '../config/siteBrand.ts';

interface Props {
	title?: string;
	description?: string;
	activeFooterId?: string;
}

const {
	title = siteName,
	description = siteDescription,
	activeFooterId,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link
			rel="preload"
			href={openSansLatin}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<style is:inline>
			.scroll-footer {
				position: fixed;
				inset-inline: 0;
				bottom: 0;
				z-index: 50;
				display: flex;
				justify-content: center;
				padding: 0.5rem 1rem max(0.5rem, env(safe-area-inset-bottom));
				background: transparent;
				pointer-events: none;
			}
			.scroll-footer__grid {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 0;
				list-style: none;
				pointer-events: auto;
			}
			.scroll-footer__item {
				margin: calc(0.5rem * 0.95);
			}
			.scroll-footer__fab {
				position: relative;
				display: flex;
				width: calc(3rem * 1.05 * 1.1);
				height: calc(3rem * 1.05 * 1.1);
				align-items: center;
				justify-content: center;
				border-radius: 9999px;
				background: #ffe10a;
				color: #212529;
				text-decoration: none;
				box-shadow:
					0 10px 15px -3px rgba(33, 37, 41, 0.12),
					0 4px 6px -4px rgba(33, 37, 41, 0.08);
			}
			.scroll-footer__fab svg {
				width: calc(14px * 1.05 * 1.1);
				height: calc(14px * 1.05 * 1.1);
				fill: currentColor;
			}
		</style>
	</head>
	<body class="site-body font-sans text-fg-ink lg:pb-0">
		<slot />

		<ContactOverFooter />
		<SiteFooter />

		<MobileFooter activeId={activeFooterId} />

		<script>
			import { scheduleScrollSiteInit } from '../scripts/scrollSite';
			import { initAnimateEntrances } from '../scripts/tourAnimate';

			scheduleScrollSiteInit();
			initAnimateEntrances();
		</script>
	</body>
</html>
