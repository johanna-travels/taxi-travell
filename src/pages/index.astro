---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstagramBloque from '../components/InstagramBloque.astro';
import CarCharterSection from '../components/CarCharterSection.astro';
import HeroSection from '../components/HeroSection.astro';
import MarketingCreamBand from '../components/MarketingCreamBand.astro';
import GoDiscoverSection from '../components/GoDiscoverSection.astro';
import SplitColumnSection from '../components/SplitColumnSection.astro';
import TourPackagesSection from '../components/TourPackagesSection.astro';
---

<BaseLayout title="Tejaku Lataxi">
	<main>
		<HeroSection />

		<div
			class="page-stack flex flex-col gap-8 pb-16 pt-8 md:gap-8 md:pb-16 md:pt-10 lg:gap-12 lg:pb-24 lg:pt-12 xl:gap-16 xl:pt-16"
		>
			<MarketingCreamBand>
				<SplitColumnSection embedded slot="first" />
			</MarketingCreamBand>
			<GoDiscoverSection />
			<TourPackagesSection />

			<CarCharterSection />
			<InstagramBloque />
		</div>
	</main>
</BaseLayout>
