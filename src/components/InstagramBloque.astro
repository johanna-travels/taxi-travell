---
import NavIcon from './NavIcon.astro';
import InstagramPostTile from './InstagramPostTile.astro';
import {
	instagramPosts,
	instagramProfileUrl,
} from '../config/instagramPosts.ts';

const handle = '@bali_personal_transport_taxi';
const username = 'bali_personal_transport_taxi';
const featuredPost = instagramPosts[0];
---

<div
	class="instagram-bloque-group instagram-bloque section relative z-[1] bg-surface-muted/40 pb-8 lg:pb-12"
	aria-labelledby="instagram-bloque-title"
>
	<div class="instagram-bloque__shell mx-auto w-full px-4 py-5 sm:py-6">
		<article class="instagram-bloque__post overflow-hidden rounded-lg border border-brand-amber/35 bg-white shadow-sm">
			<header
				class="instagram-bloque__post-head flex items-center justify-between gap-3 border-b border-surface-subtle bg-white px-3 py-2.5"
			>
				<div class="flex min-w-0 flex-1 items-center gap-2.5">
					<span
						class="footer-icon-ring footer-icon-ring--compact shrink-0"
						aria-hidden="true"
					>
						<NavIcon name="instagram" size="md" class="footer-icon-glyph" />
					</span>
					<div class="min-w-0 leading-none">
						<h3
							id="instagram-bloque-title"
							class="type-14 lh-22 truncate text-fg-gray-900"
						>
							{username}
						</h3>
						<p class="type-11-2 lh-22 truncate text-fg-gray-500">{handle}</p>
					</div>
				</div>
				<a
					href={instagramProfileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="type-12-8 shrink-0 rounded-full border-2 border-brand-amber bg-white px-3 py-1.5 text-fg-ink no-underline transition-colors hover:bg-brand-amber/15"
				>
					Follow
				</a>
			</header>

			<InstagramPostTile post={featuredPost} embedded />
		</article>
	</div>
</div>

<style>
	.instagram-bloque-group {
		position: relative;
		width: 100%;
	}

	.instagram-bloque__shell {
		max-width: min(100%, 20rem);
	}

	@media (min-width: 640px) {
		.instagram-bloque__shell {
			max-width: 22rem;
		}
	}

	@media (min-width: 768px) {
		.instagram-bloque__shell {
			max-width: 24rem;
		}
	}

	.instagram-bloque__post {
		box-shadow:
			0 0 0 1px rgba(253, 179, 23, 0.12),
			0 1px 3px rgba(33, 37, 41, 0.08);
	}

	.footer-icon-ring--compact {
		display: flex;
		width: 2rem;
		height: 2rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 2px solid var(--color-brand-amber, #fdb317);
		background: var(--color-surface-muted, #f7f7f7);
		box-shadow: 0 0 0 1px rgba(253, 179, 23, 0.22);
	}

	.footer-icon-glyph {
		color: var(--text-ink, #212529);
	}
</style>
