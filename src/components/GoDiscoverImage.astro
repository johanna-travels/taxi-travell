---
import { getImage } from 'astro:assets';
import type { GoDiscoverImage } from '../config/goDiscover.ts';
import {
	goDiscoverImageQuality,
	goDiscoverImageSizes,
	goDiscoverImageWidths,
} from '../config/goDiscover.ts';

interface Props {
	image: GoDiscoverImage;
	loading?: 'lazy' | 'eager';
}

const { image, loading = 'lazy' } = Astro.props;

const imgDefault = await getImage({
	src: image.src,
	width: goDiscoverImageWidths.default,
	format: 'webp',
	quality: goDiscoverImageQuality,
});

const imgRetina = await getImage({
	src: image.src,
	width: goDiscoverImageWidths.retina,
	format: 'webp',
	quality: goDiscoverImageQuality,
});

const aspect = image.width / image.height;
---

<figure class="go-discover-section__figure m-0 overflow-hidden rounded-lg bg-surface-muted">
	<img
		class="go-discover-section__img block h-auto w-full object-cover"
		src={imgDefault.src}
		srcset={`${imgDefault.src} ${goDiscoverImageWidths.default}w, ${imgRetina.src} ${goDiscoverImageWidths.retina}w`}
		sizes={goDiscoverImageSizes}
		width={goDiscoverImageWidths.default}
		height={Math.round(goDiscoverImageWidths.default / aspect)}
		alt={image.alt}
		loading={loading}
		decoding="async"
	/>
</figure>
