---
import NavIcon from '../components/NavIcon.astro';
import { footerNavItems } from '../config/footerNav.ts';

interface Props {
	activeId?: string;
}

const { activeId } = Astro.props;
---

<nav
	class="scroll-footer font-sans"
	aria-label="Mobile navigation"
>
	<ul class="scroll-footer__grid">
		{
			footerNavItems.map((item) => {
				const isActive = item.id === activeId;
				const isExternal = item.href.startsWith('http');
				return (
					<li class="scroll-footer__item">
						<a
							href={item.href}
							class:list={[
								'scroll-footer__fab group no-underline [-webkit-tap-highlight-color:transparent] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[6px] focus-visible:outline-brand-amber',
								item.id === 'whatsapp' && 'scroll-footer__fab--whatsapp',
								isActive && 'scroll-footer__fab--active',
							]}
							aria-label={item.label}
							{...(isExternal
								? { target: '_blank', rel: 'noopener noreferrer' }
								: {})}
							aria-current={isActive ? 'page' : undefined}
						>
							<span class="scroll-footer__tooltip type-11-2 lh-22">
								{item.label}
							</span>
							<NavIcon name={item.icon} size="md" class="scroll-footer__fab-icon" />
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>

<style>
	.scroll-footer {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: 0.5rem 1rem max(0.5rem, env(safe-area-inset-bottom));
		background: transparent;
		pointer-events: none;
	}

	.scroll-footer__grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
		pointer-events: auto;
	}

	.scroll-footer__item {
		position: relative;
		margin: calc(0.5rem * 0.95);
	}

	.scroll-footer__fab {
		position: relative;
		display: flex;
		width: calc(3rem * 1.05 * 1.1);
		height: calc(3rem * 1.05 * 1.1);
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background-color: var(--color-white, #fff);
		color: var(--color-fg-ink, #212529);
		box-shadow:
			0 10px 15px -3px rgba(33, 37, 41, 0.12),
			0 4px 6px -4px rgba(33, 37, 41, 0.08);
		cursor: pointer;
		filter: blur(0);
		opacity: 1;
		transform: translateY(0);
		transition:
			transform 0.35s ease,
			filter 0.35s ease,
			opacity 0.35s ease,
			background-color 0.2s ease;
	}

	.scroll-footer__fab::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-color: transparent;
		transition: background-color 0.2s ease;
		pointer-events: none;
	}

	.scroll-footer__fab:hover,
	.scroll-footer__fab:focus-visible {
		background-color: var(--color-surface-muted, #f7f7f7);
	}

	.scroll-footer__fab--whatsapp:hover,
	.scroll-footer__fab--whatsapp:focus-visible {
		background-color: rgba(253, 179, 23, 0.18);
	}

	.scroll-footer__fab:hover::after,
	.scroll-footer__fab:focus-visible::after {
		background-color: rgba(33, 37, 41, 0.04);
	}

	.scroll-footer__fab--whatsapp:hover::after,
	.scroll-footer__fab--whatsapp:focus-visible::after {
		background-color: rgba(253, 179, 23, 0.1);
	}

	.scroll-footer__fab-icon,
	.scroll-footer__fab :global(.nav-icon--md) {
		position: relative;
		z-index: 1;
	}

	.scroll-footer__fab :global(.nav-icon--md) {
		width: calc(var(--icon-brand-size-md, 14px) * 1.05 * 1.1);
		height: calc(var(--icon-brand-size-md, 14px) * 1.05 * 1.1);
	}

	.scroll-footer__fab--whatsapp .scroll-footer__fab-icon {
		color: var(--color-brand-amber, #fdb317);
	}

	.scroll-footer__fab--active {
		background: rgba(253, 179, 23, 0.12);
	}

	.scroll-footer__fab:hover,
	.scroll-footer__fab:focus-visible {
		transform: translateY(0) scale(1.1);
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-footer__fab {
			transition: opacity 0.35s ease, background-color 0.2s ease;
		}

		.scroll-footer__fab:hover,
		.scroll-footer__fab:focus-visible {
			transform: none;
		}

		.scroll-footer--hidden .scroll-footer__fab {
			filter: none;
		}
	}

	.scroll-footer__fab-icon {
		color: var(--color-fg-ink, #212529);
	}

	.scroll-footer__tooltip {
		position: absolute;
		left: 50%;
		top: -3rem;
		z-index: 2;
		transform: translateX(-50%);
		white-space: nowrap;
		border-radius: 0.25rem;
		background: var(--color-fg-gray-900, #111);
		padding: 0.25rem 0.5rem;
		color: var(--color-fg-white, #fff);
		box-shadow: 0 4px 6px rgba(33, 37, 41, 0.18);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.scroll-footer__fab--whatsapp .scroll-footer__tooltip {
		background: var(--color-brand-amber, #fdb317);
		color: var(--color-fg-ink, #212529);
	}

	.group:hover .scroll-footer__tooltip,
	.group:focus-visible .scroll-footer__tooltip {
		opacity: 1;
	}

	.scroll-footer--hidden {
		pointer-events: none;
	}

	.scroll-footer--hidden .scroll-footer__fab {
		filter: blur(8px);
		opacity: 0;
		transform: translateY(14px);
		pointer-events: none;
	}

	@media (min-width: 1024px) {
		.scroll-footer {
			display: none !important;
		}
	}
</style>
