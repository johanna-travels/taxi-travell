---
import { Image } from 'astro:assets';
import type { InstagramPost } from '../config/instagramPosts.ts';
import {
	instagramPortraitSizes,
	instagramTileQuality,
	instagramTileWidth,
	instagramTileWidth2x,
} from '../config/instagramImage.ts';

interface Props {
	post: InstagramPost;
	/** Full-bleed media inside `.instagram-bloque__post` — no extra frame. */
	embedded?: boolean;
}

const { post, embedded = false } = Astro.props;
---

<a
	href={post.href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		'instagram-bloque__tile group relative block w-full overflow-hidden bg-black no-underline',
		embedded && 'instagram-bloque__tile--embedded',
		!embedded && 'instagram-bloque__tile--standalone mx-auto max-w-full rounded-md',
	]}
>
	<Image
		src={post.image}
		alt={post.alt}
		widths={[instagramTileWidth, instagramTileWidth2x]}
		sizes={instagramPortraitSizes}
		format="webp"
		quality={instagramTileQuality}
		width={instagramTileWidth}
		height={Math.round((instagramTileWidth * 5) / 4)}
		class="aspect-[4/5] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.01]"
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
</a>

<style>
	.instagram-bloque__tile--embedded {
		border-radius: 0;
	}

	.instagram-bloque__tile--standalone {
		border: 1px solid var(--color-surface-subtle, #e8e8e8);
		box-shadow: 0 0 0 1px rgba(33, 37, 41, 0.06);
	}
</style>
