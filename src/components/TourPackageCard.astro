---
import type { TourPackage } from '../config/tourPackages.ts';

interface Props {
	tour: TourPackage;
}

const { tour } = Astro.props;
---

<a class="tour-package-card" href={tour.href}>
	<div class="wrap-tour">
		<img
			class="img-fluid"
			src={tour.imageUrl}
			alt={tour.imageAlt}
			width={400}
			height={300}
			loading="lazy"
			decoding="async"
		/>
		<span class="nametag">{tour.categoryLabel}</span>
		<div class="wrap-tour2">
			<h3>{tour.title}</h3>
			<span>{tour.location}</span>
			<p>{tour.excerpt}</p>
			<div class="pricendiskon">
				<p class="diskon">{tour.priceWas}</p>
				<p class="price">{tour.priceNow}</p>
			</div>
		</div>
	</div>
</a>

<style>
	.tour-package-card {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.wrap-tour {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid var(--color-surface-subtle);
		background: var(--color-white);
		box-shadow: 0 0 4px rgba(33, 37, 41, 0.23);
	}

	.img-fluid {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		vertical-align: middle;
	}

	.nametag {
		position: absolute;
		left: 0.5rem;
		top: 0.5rem;
		z-index: 1;
		padding: 0.125rem 0.625rem;
		border-radius: 9999px;
		border: 1px solid var(--color-brand-amber);
		background: var(--color-white);
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-ink);
	}

	.wrap-tour2 {
		padding: 0.75rem 0.625rem 1rem;
	}

	.wrap-tour2 h3 {
		margin: 0 0 0.25rem;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-14);
		font-weight: var(--font-weight-normal);
		line-height: var(--line-height-22);
		color: var(--text-gray-900);
	}

	.wrap-tour2 > span {
		display: block;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-secondary);
	}

	.wrap-tour2 p {
		margin: 0.5rem 0 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-gray-600);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.pricendiskon {
		margin-top: 0.75rem;
	}

	.pricendiskon .diskon {
		margin: 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-muted);
		text-decoration: line-through;
	}

	.pricendiskon .price {
		margin: 0.125rem 0 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-12-8);
		line-height: var(--line-height-22);
		color: var(--text-green);
	}
</style>
