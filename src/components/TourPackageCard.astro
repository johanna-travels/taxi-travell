---
import { getImage } from 'astro:assets';
import type { TourPackage } from '../config/tourPackages.ts';
import { tourPackagesLinksEnabled } from '../config/tourPackages.ts';
import {
	tourTileQuality,
	tourTileSizes,
	tourTileWidth,
	tourTileWidth2x,
} from '../config/tourImage.ts';

interface Props {
	tour: TourPackage;
}

const { tour } = Astro.props;

const imgDefault = await getImage({
	src: tour.image,
	width: tourTileWidth,
	format: 'webp',
	quality: tourTileQuality,
});

const imgRetina = await getImage({
	src: tour.image,
	width: tourTileWidth2x,
	format: 'webp',
	quality: tourTileQuality,
});

const imgWidth = imgDefault.attributes.width ?? tourTileWidth;
const imgHeight = imgDefault.attributes.height ?? Math.round(tourTileWidth * 0.75);
---

{
	tourPackagesLinksEnabled ? (
		<a class="tour-package-card" href={tour.href}>
			<div class="wrap-tour">
				<img
					class="img-fluid"
					src={imgDefault.src}
					srcset={`${imgDefault.src} ${tourTileWidth}w, ${imgRetina.src} ${tourTileWidth2x}w`}
					sizes={tourTileSizes}
					alt={tour.imageAlt}
					width={imgWidth}
					height={imgHeight}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
				<span class="nametag">{tour.categoryLabel}</span>
				<div class="wrap-tour2">
					<h3>{tour.title}</h3>
					<span>{tour.location}</span>
					<p>{tour.excerpt}</p>
					<div class="pricendiskon">
						<p class="diskon">{tour.priceWas}</p>
						<p class="price">{tour.priceNow}</p>
					</div>
				</div>
			</div>
		</a>
	) : (
		<article class="tour-package-card tour-package-card--static" aria-label={tour.title}>
			<div class="wrap-tour">
				<img
					class="img-fluid"
					src={imgDefault.src}
					srcset={`${imgDefault.src} ${tourTileWidth}w, ${imgRetina.src} ${tourTileWidth2x}w`}
					sizes={tourTileSizes}
					alt={tour.imageAlt}
					width={imgWidth}
					height={imgHeight}
					loading="lazy"
					decoding="async"
					fetchpriority="low"
				/>
				<span class="nametag">{tour.categoryLabel}</span>
				<div class="wrap-tour2">
					<h3>{tour.title}</h3>
					<span>{tour.location}</span>
					<p>{tour.excerpt}</p>
					<div class="pricendiskon">
						<p class="diskon">{tour.priceWas}</p>
						<p class="price">{tour.priceNow}</p>
					</div>
				</div>
			</div>
		</article>
	)
}

<style>
	.tour-package-card {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.tour-package-card--static {
		cursor: default;
	}

	.wrap-tour {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid var(--color-surface-subtle);
		background: var(--color-white);
		box-shadow: 0 0 4px rgba(33, 37, 41, 0.23);
	}

	.img-fluid {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		vertical-align: middle;
	}

	.nametag {
		position: absolute;
		left: 0.5rem;
		top: 0.5rem;
		z-index: 1;
		padding: 0.125rem 0.625rem;
		border-radius: 9999px;
		border: 1px solid var(--color-brand-amber);
		background: var(--color-white);
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-ink);
	}

	.wrap-tour2 {
		padding: 0.75rem 0.625rem 1rem;
	}

	.wrap-tour2 h3 {
		margin: 0 0 0.25rem;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-14);
		font-weight: var(--font-weight-normal);
		line-height: var(--line-height-22);
		color: var(--text-gray-900);
	}

	.wrap-tour2 > span {
		display: block;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-gray-500);
	}

	.wrap-tour2 p {
		margin: 0.5rem 0 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-12-8);
		line-height: var(--line-height-22);
		color: var(--text-gray-500);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.pricendiskon {
		margin-top: 0.75rem;
	}

	.pricendiskon .diskon {
		margin: 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-11-2);
		line-height: var(--line-height-22);
		color: var(--text-gray-500);
		text-decoration: line-through;
	}

	.pricendiskon .price {
		margin: 0.125rem 0 0;
		font-family: var(--font-family-sans);
		font-size: var(--font-size-12-8);
		line-height: var(--line-height-22);
		color: var(--text-green);
	}
</style>
