---
import { siteName } from '../config/siteBrand.ts';
---

<footer class="site-footer relative z-[1]" aria-labelledby="site-footer-heading">
	<div
		class="site-footer__credits px-4 py-4 pb-[calc(3.25rem+env(safe-area-inset-bottom))] text-center lg:py-5 lg:pb-8"
	>
		<h2 id="site-footer-heading" class="sr-only">Site credits</h2>
		<p class="type-11-2 lh-22 text-fg-gray-500">
			© {new Date().getFullYear()} {siteName} · Demo site
		</p>
		<p class="type-11-2 lh-22 mt-1 text-fg-gray-500">by Mikael STUDIOS</p>
	</div>
</footer>
