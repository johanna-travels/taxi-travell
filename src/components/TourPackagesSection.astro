---
import TourPackageCard from './TourPackageCard.astro';
import BrandIntroParagraph from './BrandIntroParagraph.astro';
import { tourPackagesCopy, tourPackagesFeatured } from '../config/tourPackages.ts';
---

<section class="tour-packages section bg-white" aria-labelledby="tour-packages-heading">
	<div class="container tour-packages__container relative z-[1]">
		<div class="title-product text-center" data-tour-packages-intro>
			<span class="type-11-2 lh-22 tracking-wide text-fg-gray-500 uppercase">
				{tourPackagesCopy.kicker}
			</span>
			<h2 id="tour-packages-heading" class="type-section-title mt-2 text-fg-gray-900">
				{tourPackagesCopy.heading}
			</h2>
			<BrandIntroParagraph
				tail={tourPackagesCopy.introTail}
				class="body-copy mx-auto mt-6 mb-12 max-w-3xl text-left text-fg-gray-500 md:mb-14 lg:mt-8 lg:mb-[4.375rem]"
			/>
		</div>

		<div class="row tour-packages__grid" data-tour-packages-grid>
			{
				tourPackagesFeatured.map((tour) => (
					<div class="col-6 col-md-3 mb-3 tour-packages__col" data-animate-fade-in-up>
						<TourPackageCard tour={tour} />
					</div>
				))
			}
		</div>

		
	</div>
</section>

<style>
	.tour-packages__container {
		max-width: 1240px;
	}

	.title-product span {
		display: block;
	}

	.tour-packages__col {
		padding-inline: 8px;
	}
</style>
