---
import type { FeatureIconName } from '../icons/feature.ts';
import { featureIconSvg } from '../icons/feature.ts';

interface Props {
	name: FeatureIconName;
	size?: 'md' | 'lg';
	class?: string;
}

const { name, size = 'md', class: className = '' } = Astro.props;

const box = size === 'lg' ? 'h-12 w-12' : 'h-10 w-10';
const glyph = size === 'lg' ? 'h-6 w-6' : 'h-5 w-5';
---

<span
	class:list={[
		'feature-icon inline-flex shrink-0 items-center justify-center rounded-full border-2 border-brand-amber bg-surface-muted text-fg-ink',
		box,
		className,
	]}
	aria-hidden="true"
>
	<span class:list={['inline-flex', glyph]} set:html={featureIconSvg[name]} />
</span>
