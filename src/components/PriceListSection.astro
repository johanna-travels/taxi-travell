---
import BrandIntroParagraph from './BrandIntroParagraph.astro';
import {
	buildTransferWhatsAppHref,
	priceListCopy,
	transferPriceRows,
} from '../config/priceList.ts';
---

<section class="price-list-section section py-12 md:py-12 lg:py-16" aria-labelledby="price-list-heading">
	<div class="container price-list-section__container relative z-[1]">
		<div class="title-product text-center" data-animate-fade-in-up>
			<span class="type-kicker-featured text-fg-gray-900">
				{priceListCopy.kicker}
			</span>
			<h2 id="price-list-heading" class="type-section-title mt-2 text-fg-gray-900">
				{priceListCopy.heading}
			</h2>
			<BrandIntroParagraph
				tail={priceListCopy.introTail}
				class="body-copy mx-auto mt-6 max-w-3xl text-left text-fg-gray-500"
			/>
		</div>

		<div class="row mt-4 justify-center">
			<div class="col-md-12 table-mobil mb-3">
				<table class="price-list-section__table w-full border-collapse">
					<caption class="sr-only">
						{priceListCopy.heading}
					</caption>
					<thead>
						<tr class="price-list-section__head-row">
							<th class="type-12-8 lh-22" scope="col">Transfer In</th>
							<th class="type-12-8 lh-22" scope="col">Transfer Out</th>
							<th class="type-12-8 lh-22" scope="col">Total Price</th>
							<th class="type-12-8 lh-22" scope="col">Reservation</th>
						</tr>
					</thead>
					<tbody>
						{
							transferPriceRows.map((row, index) => {
								const stripe = index % 2 === 1;
								const waHref = buildTransferWhatsAppHref(row.transferIn, row.transferOut);
								return (
									<tr class:list={[stripe && 'price-list-section__row--stripe']}>
										<td class="type-12-8 lh-22">{row.transferIn}</td>
										<td class="type-12-8 lh-22">{row.transferOut}</td>
										<td class="type-12-8 lh-22">{row.totalPrice}</td>
										<td class="type-12-8 lh-22">
											{row.book ? (
												<a
													class="price-list-section__book"
													href={waHref}
													target="_blank"
													rel="noopener noreferrer"
												>
													{priceListCopy.bookLabel}
												</a>
											) : (
												<span class="text-fg-muted">—</span>
											)}
										</td>
									</tr>
								);
							})
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</section>

<style>
	.price-list-section {
		--colors: var(--color-brand-amber);
		background: var(--colors);
		color: var(--text-ink);
	}

	.price-list-section__container {
		max-width: 1240px;
	}

	.type-kicker-featured {
		display: block;
	}

	.table-mobil {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.price-list-section__table {
		min-width: 320px;
		background: var(--color-white);
		border-radius: 0.375rem;
		overflow: hidden;
	}

	.price-list-section__table th,
	.price-list-section__table td {
		font-weight: var(--font-weight-normal);
		text-align: center;
		vertical-align: middle;
		padding: 0.5rem 0.375rem;
	}

	.price-list-section__head-row th {
		color: var(--text-ink);
		background: var(--color-white);
	}

	.price-list-section__table tbody td {
		color: var(--text-ink);
		background: var(--color-white);
	}

	.price-list-section__row--stripe td {
		background: var(--color-surface-subtle);
	}

	.price-list-section__book {
		color: var(--text-green);
		text-decoration: none;
	}

	.price-list-section__book:hover {
		color: var(--text-green-deep);
		text-decoration: underline;
	}

	.price-list-section__book:focus-visible {
		outline: 2px solid var(--text-ink);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
