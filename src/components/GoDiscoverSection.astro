---
import GoDiscoverImage from './GoDiscoverImage.astro';
import {
	goDiscoverCopy,
	goDiscoverCtaHref,
	goDiscoverImage,
} from '../config/goDiscover.ts';
import { btnContact1Classes } from '../config/tourPackages.ts';
import { featureIconSvg } from '../icons/feature.ts';
---

<section
	class="go-discover-section section w-full bg-white py-12 md:py-12 lg:py-16"
	aria-labelledby="go-discover-heading"
>
	<div class="container go-discover-section__container relative z-[1]">
		<div class="go-discover-section__grid">
			<div class="go-discover-section__intro">
				<p
					class="type-11-2 lh-22 tracking-wide text-fg-gray-500 uppercase"
					data-animate-fade-in-down
				>
					{goDiscoverCopy.kicker}
				</p>
				<h2
					id="go-discover-heading"
					class="type-section-title mt-2 text-fg-gray-900"
					data-animate-fade-in-down
				>
					{goDiscoverCopy.heading}
				</h2>
				<p
					class="body-copy mt-6 text-fg-gray-500"
					data-animate-fade-in-down
					set:html={goDiscoverCopy.bodyHtml}
				/>
				<p class="mt-8" data-animate-fade-in-down>
					<a
						class={`${btnContact1Classes} gap-2`}
						href={goDiscoverCtaHref}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span
							class="inline-flex h-4 w-4 shrink-0"
							set:html={featureIconSvg['arrow-right']}
							aria-hidden="true"
						/>
						<span>{goDiscoverCopy.ctaLabel}</span>
					</a>
				</p>
			</div>

			<div class="go-discover-section__media" data-animate-fade-in-up data-animate-delay="300">
				<GoDiscoverImage image={goDiscoverImage} />
			</div>
		</div>
	</div>
</section>

<style>
	.go-discover-section__container {
		max-width: 1240px;
	}

	.go-discover-section__grid {
		display: grid;
		gap: 2rem 1.5rem;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.go-discover-section__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			gap: 2.5rem 2rem;
		}
	}

	.body-copy :global(strong) {
		font-weight: 600;
		color: var(--text-gray-900);
	}
</style>
